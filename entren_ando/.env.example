# Copia este archivo como .env (en esta misma carpeta, entren_ando/) y llénalo.
# .env NO se sube a GitHub (está en .gitignore).
#
# Supabase > Project Settings > API (o el botón "Connect"):
#   SUPABASE_URL      = Project URL
#   SUPABASE_ANON_KEY = anon / publishable key (NUNCA la service_role)
#
# Se usa así:  flutter run --dart-define-from-file=.env
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Solo modo de prueba (ENT-44): contraseña de demo@entrenando.test en Supabase.
DEMO_PASSWORD=
